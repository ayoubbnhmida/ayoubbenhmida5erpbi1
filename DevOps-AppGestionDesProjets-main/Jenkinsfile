
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Backend') {
            steps {
                dir('DevOps-AppGestionDesProjets-main/backend') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Test Backend') {
            steps {
                dir('DevOps-AppGestionDesProjets-main/backend') {
                    sh 'mvn test'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    dir('DevOps-AppGestionDesProjets-main/backend') {
                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:3.11.0.3922:sonar \
                            -Dsonar.projectKey=DevOps-AppGestionDesProjets \
                            -Dsonar.projectName="DevOps App Gestion des Projets"
                        '''
                    }
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('DevOps-AppGestionDesProjets-main/frontend') {
                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'DevOps-AppGestionDesProjets-main/backend/target/*.jar',
                                 fingerprint: true
            }
        }
    }
}
